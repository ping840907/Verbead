<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════ Text ══════════ -->
    <style name="Verbead.Text.Headline" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Verbead.Text.Title" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Verbead.Text.Body" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:includeFontPadding">true</item>
    </style>

    <style name="Verbead.Text.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Section label that sits above a card group -->
    <style name="Verbead.Text.Section" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_light_primary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Status pill; background drawable + color are set from code -->
    <style name="Verbead.Text.Badge" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- ══════════ Cards ══════════ -->
    <style name="Verbead.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_container</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Verbead.Card.Primary" parent="Verbead.Card">
        <item name="cardBackgroundColor">@color/md_theme_light_primaryContainer</item>
    </style>

    <style name="Verbead.Card.Warning" parent="Verbead.Card">
        <item name="cardBackgroundColor">@color/status_warning_container</item>
    </style>

    <style name="Verbead.Card.Selectable" parent="Verbead.Card">
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/surface_card_stroke</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ══════════ Buttons ══════════ -->
    <style name="Verbead.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <style name="Verbead.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <style name="Verbead.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <style name="Verbead.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Small tonal pill used as the trailing action of a row -->
    <style name="Verbead.Button.Compact" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <!-- Segmented-style choice (selection tinting is applied from code) -->
    <style name="Verbead.Button.Choice" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Verbead.Button.ChoiceOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- ══════════ Misc ══════════ -->
    <style name="Verbead.Divider" parent="">
        <item name="android:background">@color/md_theme_light_outlineVariant</item>
        <item name="android:alpha">0.6</item>
    </style>

    <style name="Verbead.Row" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Round tonal container hosting a 24dp glyph -->
    <style name="Verbead.RowIcon" parent="">
        <item name="android:background">@drawable/bg_icon_circle</item>
        <item name="android:padding">10dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/md_theme_light_onPrimaryContainer</item>
    </style>

</resources>
