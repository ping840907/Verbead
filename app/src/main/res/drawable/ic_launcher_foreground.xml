<?xml version="1.0" encoding="utf-8"?>
<!--
    珠璣 (Verbead) app icon: "pearl in the voice"
    - A sound waveform (four rounded bars) with a pearl where its peak would be:
      speech goes in, a polished word comes out.
    - Everything sits inside the 66dp safe zone, so any launcher mask fits.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer bars (quieter) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.72"
        android:pathData="M24,50 a3,3 0 0 1 6,0 v8 a3,3 0 0 1 -6,0 Z M78,50 a3,3 0 0 1 6,0 v8 a3,3 0 0 1 -6,0 Z" />

    <!-- inner bars -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,43 a3,3 0 0 1 6,0 v22 a3,3 0 0 1 -6,0 Z M68,43 a3,3 0 0 1 6,0 v22 a3,3 0 0 1 -6,0 Z" />

    <!-- the pearl -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,54 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />

    <!-- its lustre -->
    <path
        android:fillColor="@color/md_theme_light_primary"
        android:fillAlpha="0.28"
        android:pathData="M47.6,50.4 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48.6,50.6 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z" />
</vector>
