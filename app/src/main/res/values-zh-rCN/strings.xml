    <!-- Onboarding Tour -->
    <string name="onboarding_tour_title">操作导览</string>
    <string name="onboarding_page1_title">随处悬浮 · 点击即说</string>
    <string name="onboarding_page1_desc">在任何 App 的输入框轻触悬浮球即可收音，识别结果自动填入，无需换键盘。</string>
    <string name="onboarding_page1_tip">悬浮球变红表示正在收音，再点一次或停顿即发送。</string>
    <string name="onboarding_page2_title">垂直胶囊 · 四大模式随心切换</string>
    <string name="onboarding_page2_desc">四种模式：语音输入、条码扫描、文字识别（PP-OCRv6）、常用语与历史。</string>
    <string name="onboarding_page2_tip">松开手指即切换并使用。</string>
    <string name="onboarding_page3_title">悬浮 X 键 · 一键撤回与还原</string>
    <string name="onboarding_page3_desc">填入后 10 秒内，点悬浮球上方的 ↶ 键即可还原原来的文字。</string>
    <string name="onboarding_page3_tip">↶ 键会在填入后出现在悬浮球上方。</string>
    <string name="onboarding_page4_title">贴边收纳 · 键盘联动 · 摇晃分身</string>
    <string name="onboarding_page4_desc" formatted="false">拖到屏幕边缘会自动收纳；拖动时快速左右摇晃可分裂新球（最多 4 个）。</string>
    <string name="onboarding_page4_tip">各球独立记忆模式；拖到顶部删除区即可移除。</string>
    <string name="onboarding_page5_title" formatted="false">100% 离线端侧 · 一站式主设置</string>
    <string name="onboarding_page5_desc">语音与文字识别都在手机本机运行，不上传云端。权限与模型都在主设置页管理。</string>
    <string name="onboarding_page5_tip">点下方按钮前往主设置。</string>

