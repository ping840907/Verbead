<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_bubble_root"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="2dp">

    <!-- Mic Button Container (56dp circular) -->
    <FrameLayout
        android:id="@+id/btn_bubble_mic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/bubble_background"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_bubble_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/floating_bubble_desc" />

        <ProgressBar
            android:id="@+id/progress_bubble"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />

        <!-- 收納到邊緣時，在露出的那一側顯示的小拉出箭頭（顯示與方向由 FloatingBubbleItem 控制） -->
        <ImageView
            android:id="@+id/iv_tuck_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="1dp"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tuck_arrow"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
