<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Mockup Animation Card (the screen boundary clips what slides in and out of it) -->
    <FrameLayout
        android:id="@+id/frame_mock_phone_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_mockup_screen"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:padding="16dp"
        android:tag="keepClip">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Simulated App Top Bar: title and the keyboard state badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/Verbead.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_gestures_title"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:id="@+id/iv_mock_kbd_badge"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="?attr/colorSurfaceVariant"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_keyboard"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Guide Explanation Card inside mockup -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/md_theme_light_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_mock_tuck_status_title"
                        style="@style/Verbead.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_gesture_edge_title"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_mock_tuck_status_desc"
                        style="@style/Verbead.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/onboarding_gesture_edge_desc"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- The app's text field: it rides up on top of the keyboard when the keyboard opens -->
        <LinearLayout
            android:id="@+id/layout_mock_input"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_test_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <View
                android:layout_width="96dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_mock_line" />

            <View
                android:id="@+id/view_mock_caret"
                android:layout_width="2dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:background="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Soft keyboard: slides up from, and back down behind, the bottom edge of the screen -->
        <FrameLayout
            android:id="@+id/holder_mock_keyboard"
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_gravity="bottom"
            android:clipChildren="true">

            <com.ping.verbead.ui.MockKeyboardView
                android:id="@+id/view_mock_keyboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:translationY="124dp" />
        </FrameLayout>

        <!-- Finger tap that opens the keyboard -->
        <View
            android:id="@+id/view_mock_kbd_tap"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="52dp"
            android:layout_marginBottom="11dp"
            android:alpha="0"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="?attr/colorPrimary" />

        <!-- The bubbles live in a layer that does not clip them to their own bounds, so their glow can spill;
             the screen frame around it still cuts everything at the screen edge. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

        <!-- Secondary Clone Floating Bubble (for Phase 3 shake-to-duplicate demo) -->
        <com.ping.verbead.ui.GlassBubbleLayout
            android:id="@+id/layout_mock_clone_bubble"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:alpha="0"
            android:elevation="5dp">

            <ImageView
                android:id="@+id/iv_mock_clone_bubble_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ocr"
                app:tint="@android:color/white" />
        </com.ping.verbead.ui.GlassBubbleLayout>

        <!-- The Floating Bubble that animates tucking, keyboard sync, and shake-to-duplicate -->
        <com.ping.verbead.ui.GlassBubbleLayout
            android:id="@+id/layout_mock_tuck_bubble"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/iv_mock_tuck_bubble_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@android:color/white" />

            <!-- Same pull-out arrow as the real bubble, shown while it is tucked at the edge -->
            <ImageView
                android:id="@+id/iv_mock_tuck_arrow"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="1dp"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tuck_arrow" />
        </com.ping.verbead.ui.GlassBubbleLayout>
        </FrameLayout>

    </FrameLayout>

    <!-- Slide Text Content -->
    <TextView
        style="@style/Verbead.Text.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/onboarding_page4_title"
        android:textSize="22sp" />

    <TextView
        style="@style/Verbead.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/onboarding_page4_desc"
        android:textColor="@color/text_secondary" />

    <!-- Feature Tip Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_info_neutral"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Verbead.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_page4_tip"
            android:textColor="?attr/colorOnSecondaryContainer" />
    </LinearLayout>
</LinearLayout>
