<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Mockup Animation Card (Screen boundary clips children) -->
    <FrameLayout
        android:id="@+id/frame_mock_phone_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_mockup_screen"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Simulated App Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/md_theme_light_outlineVariant" />

                <TextView
                    style="@style/Verbead.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="收納與聯動 · 貼邊 30% 與鍵盤感應"
                    android:textColor="@color/text_tertiary" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/status_success_text" />
            </LinearLayout>

            <!-- Guide Explanation Card inside mockup -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/md_theme_light_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_mock_tuck_status_title"
                        style="@style/Verbead.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. 邊緣收納：超出邊界 70%"
                        android:textColor="@color/md_theme_light_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_mock_tuck_status_desc"
                        style="@style/Verbead.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="自動藏入螢幕邊緣，僅露 30% 圓弧，輕點即可拉出"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Simulated Software Keyboard (Slides up and down at bottom) -->
        <LinearLayout
            android:id="@+id/layout_mock_keyboard"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_info_neutral"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:translationY="90dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="22dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_test_input" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_test_input" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_test_input" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_test_input" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_test_input" />
            </LinearLayout>

            <TextView
                style="@style/Verbead.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系統軟體鍵盤 (Gboard / 注音)"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- The Floating Bubble that animates tucking and keyboard sync -->
        <FrameLayout
            android:id="@+id/layout_mock_tuck_bubble"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="-16dp"
            android:background="@drawable/bubble_background"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/iv_mock_tuck_bubble_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@android:color/white" />
        </FrameLayout>

    </FrameLayout>

    <!-- Slide Text Content -->
    <TextView
        style="@style/Verbead.Text.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/onboarding_page4_title"
        android:textSize="22sp" />

    <TextView
        style="@style/Verbead.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/onboarding_page4_desc"
        android:textColor="@color/text_secondary" />

    <!-- Feature Tip Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_info_neutral"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Verbead.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_page4_tip"
            android:textColor="@color/md_theme_light_primary" />
    </LinearLayout>
</LinearLayout>
