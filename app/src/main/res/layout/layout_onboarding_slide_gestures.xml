<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Mockup Animation Card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_mockup_screen"
        android:clipChildren="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Simulated App Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/md_theme_light_outlineVariant" />

                <TextView
                    style="@style/Verbead.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="手勢教學 · 貼邊與快捷關閉"
                    android:textColor="@color/text_tertiary" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/status_success_text" />
            </LinearLayout>

            <!-- Guide Step Explanation Card inside mockup -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/md_theme_light_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_mock_gesture_status_title"
                        style="@style/Verbead.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="手勢 1：貼邊半透明收納"
                        android:textColor="@color/md_theme_light_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_mock_gesture_status_desc"
                        style="@style/Verbead.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="將懸浮球移至螢幕左右邊緣，自動吸附並淡化"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Right-edge docked preview guide line/indicator -->
        <View
            android:id="@+id/view_mock_edge_dock"
            android:layout_width="4dp"
            android:layout_height="80dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="-16dp"
            android:background="@color/md_theme_light_primary" />

        <!-- Bottom dismiss target zone (✕) -->
        <LinearLayout
            android:id="@+id/layout_mock_dismiss_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btn_mock_dismiss_circle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bubble_x_background">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_mock_dismiss_label"
                style="@style/Verbead.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="拖曳至此關閉"
                android:textColor="@color/status_warning_text"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- The Animated Floating Bubble that traverses gestures -->
        <FrameLayout
            android:id="@+id/layout_mock_gesture_bubble"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bubble_background"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/iv_mock_gesture_bubble_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@android:color/white" />
        </FrameLayout>

    </FrameLayout>

    <!-- Slide Text Content -->
    <TextView
        style="@style/Verbead.Text.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/onboarding_page3_title"
        android:textSize="22sp" />

    <TextView
        style="@style/Verbead.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/onboarding_page3_desc"
        android:textColor="@color/text_secondary" />

    <!-- Feature Tip Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_info_neutral"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Verbead.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_page3_tip"
            android:textColor="@color/md_theme_light_primary" />
    </LinearLayout>
</LinearLayout>
