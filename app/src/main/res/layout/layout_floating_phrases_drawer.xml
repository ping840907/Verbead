<?xml version="1.0" encoding="utf-8"?>
<com.ping.verbead.ui.GlassLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_phrases_drawer_root"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    app:glassRadius="20dp"
        app:glassFrosted="true"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp">

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_close_phrases_drawer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/phrases_drawer_close_desc"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassFollowBubble="true" />

        <TextView
            android:id="@+id/tv_phrases_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/common_quick_phrases"
            android:textColor="#EEFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_add_phrase"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/phrases_drawer_add_desc"
            android:padding="6dp"
            android:src="@drawable/ic_add"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassFollowBubble="true" />
    </RelativeLayout>

    <!-- Content: Phrases List & Empty State -->
    <FrameLayout
        android:id="@+id/container_phrases_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_phrases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/ll_empty_phrases"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_quick_phrases"
                app:tint="#66FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/empty_quick_phrases"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </FrameLayout>

</com.ping.verbead.ui.GlassLinearLayout>
