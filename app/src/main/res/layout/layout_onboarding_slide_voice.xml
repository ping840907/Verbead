<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Mockup Animation Card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_mockup_screen"
        android:clipChildren="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Simulated App Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/md_theme_light_outlineVariant" />

                <TextView
                    style="@style/Verbead.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="任何應用程式 · 即刻輸入"
                    android:textColor="@color/text_tertiary" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/status_success_text" />
            </LinearLayout>

            <!-- Simulated Chat Bubble from other person -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_info_neutral"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/Verbead.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="請問今天下午的會議幾點開始？"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Simulated Input Field with typing effect -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_test_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tv_mock_voice_input"
                    style="@style/Verbead.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="點擊懸浮球開始輸入..."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <!-- Cursor view -->
                <View
                    android:id="@+id/view_mock_cursor"
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:background="@color/md_theme_light_primary"
                    android:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Simulated Floating Speech Bubble & Animation Layer -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="54dp"
            android:clipChildren="false">

            <!-- Ripple effect ring -->
            <View
                android:id="@+id/view_mock_bubble_ripple"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bubble_background_active" />

            <!-- The Bubble -->
            <FrameLayout
                android:id="@+id/layout_mock_bubble"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bubble_background">

                <ImageView
                    android:id="@+id/iv_mock_bubble_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <!-- Simulated finger touch dot (Taps bubble to start recording) -->
            <View
                android:id="@+id/view_mock_voice_finger"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/md_theme_light_primary"
                android:elevation="12dp" />

            <!-- Floating Preview Pill above bubble -->
            <LinearLayout
                android:id="@+id/layout_mock_preview_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-36dp"
                android:alpha="0"
                android:background="@drawable/bg_ocr_pill_btn"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp">

                <!-- 3 Animated Soundwave Bars -->
                <LinearLayout
                    android:id="@+id/layout_mock_waveform"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/mock_wave_1"
                        android:layout_width="3dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_waveform_bar" />

                    <View
                        android:id="@+id/mock_wave_2"
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_waveform_bar" />

                    <View
                        android:id="@+id/mock_wave_3"
                        android:layout_width="3dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_waveform_bar" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_mock_preview_status"
                    style="@style/Verbead.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正在聆聽…"
                    android:textColor="@color/md_theme_light_primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Slide Text Content -->
    <TextView
        style="@style/Verbead.Text.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/onboarding_page1_title"
        android:textSize="22sp" />

    <TextView
        style="@style/Verbead.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/onboarding_page1_desc"
        android:textColor="@color/text_secondary" />

    <!-- Feature Tip Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_info_neutral"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Verbead.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_page1_tip"
            android:textColor="@color/md_theme_light_primary" />
    </LinearLayout>
</LinearLayout>
