                <!-- Apache Commons Compress -->
                <LinearLayout
                    android:id="@+id/row_credit_commons_compress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        style="@style/Verbead.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_about_commons_compress_title"
                        android:textColor="@color/md_theme_light_primary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Verbead.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_about_commons_compress_credit" />
                </LinearLayout>
            </LinearLayout>
        </com.ping.verbead.ui.GlassCard>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
