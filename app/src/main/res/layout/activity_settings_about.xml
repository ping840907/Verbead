                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_about_nvidia_asr_credit" />
                </LinearLayout>

                <!-- Moonshine -->
                <LinearLayout
                    android:id="@+id/row_credit_moonshine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
