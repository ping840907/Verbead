                    <TextView
                        style="@style/Verbead.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_about_material_title"
                        android:textColor="@color/md_theme_light_primary"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Verbead.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_about_material_credit" />
