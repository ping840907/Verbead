<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- ── Top Header Bar ────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/onboarding_tour_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_skip"
            style="@style/Verbead.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="略過"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- ── Interactive Slides ViewPager2 ─────────────────────────────── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_onboarding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── Bottom Navigation & Dot Indicators ────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_prev"
            style="@style/Verbead.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="上一步"
            android:textColor="@color/text_secondary"
            android:visibility="invisible" />

        <!-- Dots Indicator Container -->
        <LinearLayout
            android:id="@+id/layout_onboarding_dots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_0"
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_indicator_dot_active" />

            <View
                android:id="@+id/dot_1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_indicator_dot_inactive" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_indicator_dot_inactive" />

            <View
                android:id="@+id/dot_3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_indicator_dot_inactive" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_next"
            style="@style/Verbead.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp"
            android:text="下一步" />
    </LinearLayout>

</LinearLayout>
