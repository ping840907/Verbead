<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Mockup Animation Card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_mockup_screen"
        android:clipChildren="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Simulated App Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/md_theme_light_outlineVariant" />

                <TextView
                    style="@style/Verbead.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="即時復原 · 點擊上方 ✕ 鍵撤回"
                    android:textColor="@color/text_tertiary" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/status_success_text" />
            </LinearLayout>

            <!-- Simulated Chat Bubble from other person -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_info_neutral"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/Verbead.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="請問簡報檔案在哪裡？"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Simulated Input Field with typed text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_test_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tv_mock_undo_input"
                    style="@style/Verbead.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="點擊懸浮球輸入..."
                    android:text="今天開會時間是兩點整。"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/view_mock_undo_cursor"
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:background="@color/md_theme_light_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Floating Bubble & X Button Layer (Right bottom) -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="54dp"
            android:clipChildren="false">

            <!-- Floating Preview Pill above X button -->
            <TextView
                android:id="@+id/tv_mock_undo_toast"
                style="@style/Verbead.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-78dp"
                android:alpha="0"
                android:background="@drawable/bg_ocr_pill_btn"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="已復原輸入內容"
                android:textColor="@color/md_theme_light_primary"
                android:textStyle="bold" />

            <!-- Small Floating X Button (Appears above the bubble) -->
            <FrameLayout
                android:id="@+id/btn_mock_undo_x"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-46dp"
                android:background="@drawable/bubble_x_background"
                android:elevation="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <!-- Main Floating Bubble -->
            <FrameLayout
                android:id="@+id/layout_mock_undo_bubble"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bubble_background"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <!-- Animated Touch Finger Dot targeting X button -->
            <View
                android:id="@+id/view_mock_undo_finger"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-37dp"
                android:alpha="0"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/md_theme_light_primary"
                android:elevation="12dp" />
        </FrameLayout>
    </FrameLayout>

    <!-- Slide Text Content -->
    <TextView
        style="@style/Verbead.Text.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/onboarding_page3_title"
        android:textSize="22sp" />

    <TextView
        style="@style/Verbead.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/onboarding_page3_desc"
        android:textColor="@color/text_secondary" />

    <!-- Feature Tip Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_info_neutral"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Verbead.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_page3_tip"
            android:textColor="@color/md_theme_light_primary" />
    </LinearLayout>
</LinearLayout>
