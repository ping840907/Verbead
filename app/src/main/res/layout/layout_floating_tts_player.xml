<?xml version="1.0" encoding="utf-8"?>
<com.ping.verbead.ui.GlassLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tts_player_root"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    app:glassRadius="20dp"
    app:glassFrosted="true"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header: close, source label, reload, speed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_tts_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/tts_close_desc"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassFollowBubble="true" />

        <TextView
            android:id="@+id/tv_tts_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/tts_mode_title"
            android:textColor="#EEFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_tts_reload"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/tts_reload_desc"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassFollowBubble="true" />

        <TextView
            android:id="@+id/btn_tts_speed"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:contentDescription="@string/tts_speed_desc"
            android:text="1.0x"
            android:textColor="#EEFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- The sentence being read, with its neighbours; the current one is highlighted -->
    <TextView
        android:id="@+id/tv_tts_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="8"
        android:minLines="8"
        android:padding="4dp"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_tts_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#99FFFFFF"
        android:textSize="12sp" />

    <!-- Transport controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_tts_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/tts_prev_desc"
            android:padding="10dp"
            android:src="@drawable/ic_skip_previous"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassFollowBubble="true" />

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_tts_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/tts_pause_desc"
            android:padding="12dp"
            android:src="@drawable/ic_pause"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassFollowBubble="true" />

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_tts_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/tts_next_desc"
            android:padding="10dp"
            android:src="@drawable/ic_skip_next"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassFollowBubble="true" />
    </LinearLayout>

</com.ping.verbead.ui.GlassLinearLayout>
