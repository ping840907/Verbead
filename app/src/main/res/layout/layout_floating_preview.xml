<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_preview_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="14dp">

    <com.ping.verbead.ui.GlassFrameLayout
        android:id="@+id/card_bubble_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:glassRadius="18dp">

        <!-- clips the text while it scrolls (marquee) when a status line is wider than the card -->
        <FrameLayout
            android:id="@+id/fl_preview_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="true">

            <TextView
                android:id="@+id/tv_bubble_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"
                android:maxLines="3"
                android:ellipsize="start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/floating_preview_recognizing"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />
        </FrameLayout>
    </com.ping.verbead.ui.GlassFrameLayout>
</FrameLayout>
