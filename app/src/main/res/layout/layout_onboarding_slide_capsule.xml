<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Mockup Animation Card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_mockup_screen"
        android:clipChildren="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Simulated App Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/md_theme_light_outlineVariant" />

                <TextView
                    style="@style/Verbead.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="垂直膠囊 · 三大功能隨心切換"
                    android:textColor="@color/text_tertiary" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/status_success_text" />
            </LinearLayout>

            <!-- Mode Description Badge inside screen -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mock_mode_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="68dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/md_theme_light_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_mock_active_mode_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/md_theme_light_primary" />

                        <TextView
                            android:id="@+id/tv_mock_active_mode_title"
                            style="@style/Verbead.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="語音即時輸入"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_mock_active_mode_desc"
                        style="@style/Verbead.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="高精準度離線語音辨識，輕觸即開始聽寫"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Hint text inside screen -->
            <TextView
                style="@style/Verbead.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:text="長按並滑動手指，或直接點選按鈕切換"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>

        <!-- Vertical Capsule Floating Menu Mockup (Right side) -->
        <FrameLayout
            android:id="@+id/layout_mock_capsule_container"
            android:layout_width="56dp"
            android:layout_height="168dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp">

            <!-- Pill background -->
            <LinearLayout
                android:id="@+id/layout_mock_capsule_pill"
                android:layout_width="56dp"
                android:layout_height="168dp"
                android:background="@drawable/bg_capsule_menu"
                android:elevation="10dp"
                android:orientation="vertical">

                <!-- Voice Mode -->
                <FrameLayout
                    android:id="@+id/mock_item_voice"
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <ImageView
                        android:id="@+id/mock_icon_voice"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <!-- Barcode Mode -->
                <FrameLayout
                    android:id="@+id/mock_item_barcode"
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <ImageView
                        android:id="@+id/mock_icon_barcode"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_barcode"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <!-- OCR Mode -->
                <FrameLayout
                    android:id="@+id/mock_item_ocr"
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <ImageView
                        android:id="@+id/mock_icon_ocr"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_ocr"
                        app:tint="@android:color/white" />
                </FrameLayout>
            </LinearLayout>

            <!-- Floating animated highlight indicator selector -->
            <View
                android:id="@+id/view_mock_capsule_highlight"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_capsule_indicator"
                android:elevation="11dp" />

            <!-- Simulated finger touch dot -->
            <View
                android:id="@+id/view_mock_touch_finger"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="17dp"
                android:alpha="0.75"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/md_theme_light_primary"
                android:elevation="12dp" />
        </FrameLayout>
    </FrameLayout>

    <!-- Slide Text Content -->
    <TextView
        style="@style/Verbead.Text.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/onboarding_page2_title"
        android:textSize="22sp" />

    <TextView
        style="@style/Verbead.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/onboarding_page2_desc"
        android:textColor="@color/text_secondary" />

    <!-- Feature Tip Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_info_neutral"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Verbead.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_page2_tip"
            android:textColor="@color/md_theme_light_primary" />
    </LinearLayout>
</LinearLayout>
