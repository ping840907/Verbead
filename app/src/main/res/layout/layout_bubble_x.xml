<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btn_bubble_x"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Sea Glass disc; the icon switches between cancel (X) and undo (back arrow) -->
    <com.ping.verbead.ui.GlassIconView
        android:id="@+id/iv_bubble_x_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center"
        android:contentDescription="@string/common_close"
        android:padding="9dp"
        android:src="@drawable/ic_close"
        app:glassTint="#4F7A73" />
</FrameLayout>
