<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_ocr_snapshot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Frozen Snapshot Frame Container -->
    <FrameLayout
        android:id="@+id/container_snapshot_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/iv_ocr_snapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <com.ping.verbead.ocr.OcrBoxesOverlayView
            android:id="@+id/view_ocr_boxes"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_close_ocr"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/common_close"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassFollowBubble="true" />

        <TextView
            android:id="@+id/tv_ocr_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/ocr_snapshot_detecting"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_ocr"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true"
            android:indeterminateTint="#64B5F6"
            android:visibility="visible" />

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_rotate_ocr"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/ocr_snapshot_rotate_desc"
            android:padding="8dp"
            android:src="@drawable/ic_rotate"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassFollowBubble="true" />
    </LinearLayout>

    <!-- Bottom Action Bar (Multi-select Actions) -->
    <LinearLayout
        android:id="@+id/layout_ocr_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="#E61A1E26"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <com.ping.verbead.ui.GlassTagText
            android:id="@+id/btn_ocr_select_all"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/ocr_snapshot_select_all"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:glassFollowBubble="true" />

        <com.ping.verbead.ui.GlassTagText
            android:id="@+id/btn_ocr_clear"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/ocr_snapshot_clear"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            app:glassFollowBubble="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.ping.verbead.ui.GlassTagText
            android:id="@+id/btn_ocr_confirm"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/ocr_snapshot_recognize_and_input"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:glassFollowBubble="true"
            app:glassAccent="true" />
    </LinearLayout>

</FrameLayout>
