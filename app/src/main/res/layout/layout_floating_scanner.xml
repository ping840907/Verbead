<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.ping.verbead.ui.GlassLinearLayout
        android:id="@+id/layout_scanner_root"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        app:glassRadius="20dp"
        app:glassFrosted="true"
        android:orientation="vertical"
        android:padding="8dp">

    <!-- Top Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="4dp">

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_close_scanner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/floating_scanner_close_desc"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassTint="#4F7A73" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/floating_scanner_title"
            android:textColor="#EEFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- 縮放鍵 (Scale/Resize Toggle) -->
            <com.ping.verbead.ui.GlassIconView
                android:id="@+id/btn_scanner_scale"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/floating_resize_window_desc"
                android:padding="6dp"
                android:src="@drawable/ic_fullscreen"
                app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassTint="#4F7A73" />

            <!-- 閃光燈 (Flash Toggle) -->
            <com.ping.verbead.ui.GlassIconView
                android:id="@+id/btn_scanner_flash"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/floating_flash_desc"
                android:padding="6dp"
                android:src="@drawable/ic_flash_off"
                app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassTint="#4F7A73" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Center Camera Preview Area (Square) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_scanner_preview"
        android:layout_width="234dp"
        android:layout_height="234dp"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/scanner_view_finder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:implementationMode="compatible" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Zooming Slider below camera view -->
    <com.ping.verbead.ui.GlassSeekBar
        app:glassDark="true"
        android:id="@+id/slider_scanner_zoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#CFE6E1"
        android:thumbTint="#E6F4F1" />

    <!-- Bottom Controls: Auto-Enter toggle and hint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <com.ping.verbead.ui.GlassIconView
            android:id="@+id/btn_scanner_auto_enter"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/floating_wrap_desc"
            android:padding="6dp"
            android:src="@drawable/ic_auto_enter_on"
            app:tint="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true"
            app:glassTint="#4F7A73" />

        <TextView
            android:id="@+id/tv_scanner_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/floating_scanner_hint"
            android:textColor="#B0FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    </com.ping.verbead.ui.GlassLinearLayout>

</FrameLayout>
