<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_slm_chat_root"
    android:layout_width="320dp"
    android:layout_height="440dp"
    android:background="@drawable/bg_scanner_window"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/layout_slm_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp">

        <ImageButton
            android:id="@+id/btn_close_slm_chat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_scanner_btn_circle"
            android:contentDescription="關閉 AI 對話"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFFFF" />

        <!-- Title & Icon -->
        <LinearLayout
            android:id="@+id/layout_slm_title_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_close_slm_chat"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_ai_sparkle"
                app:tint="#38BDF8"
                android:contentDescription="端側 AI" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="端側 AI"
                android:textColor="#EEFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Controls: Model Toggle & Thinking Toggle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Model Switcher Chip -->
            <TextView
                android:id="@+id/btn_slm_model_toggle"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_slm_chip_active"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="1.5B 聰明"
                android:textColor="#E0F2FE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Thinking Toggle Chip -->
            <LinearLayout
                android:id="@+id/btn_slm_thinking_toggle"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_slm_chip_active"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_slm_thinking_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_thinking"
                    app:tint="#FBBF24"
                    android:contentDescription="思考開關" />

                <TextView
                    android:id="@+id/tv_slm_thinking_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="思考"
                    android:textColor="#FEF3C7"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Chat Message List Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_slm_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

        <!-- Empty State Hint -->
        <LinearLayout
            android:id="@+id/layout_slm_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_ai_sparkle"
                app:tint="#38BDF8"
                android:contentDescription="端側小語言模型" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="端側小語言模型 (SLM) 已就緒"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="• 點擊麥克風可用離線語音下達指令\n• 預設簡短扼要回覆，支援思考推導\n• 回覆後可一鍵複製或直接貼入輸入框"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_slm_input_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <!-- Voice Input Button (Mic) -->
        <ImageButton
            android:id="@+id/btn_slm_mic"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_scanner_btn_circle"
            android:contentDescription="語音輸入"
            android:padding="7dp"
            android:src="@drawable/ic_mic"
            app:tint="#38BDF8" />

        <!-- Text Input -->
        <EditText
            android:id="@+id/et_slm_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@null"
            android:hint="語音或輸入指令..."
            android:textColorHint="#64748B"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:maxLines="3"
            android:inputType="textCapSentences|textMultiLine"
            android:importantForAutofill="no" />

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/btn_slm_send"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_scanner_btn_circle"
            android:contentDescription="送出"
            android:padding="7dp"
            android:src="@drawable/ic_send"
            app:tint="#0284C7" />
    </LinearLayout>

</LinearLayout>
