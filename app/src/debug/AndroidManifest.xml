            android:name=".OcrGpuProbeReceiver"
            android:exported="true" />
        <receiver
            android:name=".PendingTextDebugReceiver"
            android:exported="true" />
        <!-- Debug only: read-aloud phase 0 — TTS speed benchmark and "what can the screen reader see" probe -->
